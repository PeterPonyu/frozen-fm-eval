\@writefile{toc}{\contentsline {subsection}{Self-computed scRNA suite: calibration and reliability (cluster K)}{21}{subsection*.37}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Self-computed (cluster K): frozen scGPT cross-batch conformal coverage is unstable (gap $>0$ in all four atlases---0.012--0.075 in three, and 0.123 on lung under the depth ablation), and discrimination transfers while calibration does not---the highest-capacity readout (MLP-256) worsens ECE and temperature scaling closes only $\sim $1/3 of the gap.}}{21}{figure.caption.38}\protected@file@percent }
\newlabel{fig:scrnacalib}{{12}{21}{Self-computed (cluster K): frozen scGPT cross-batch conformal coverage is unstable (gap $>0$ in all four atlases---0.012--0.075 in three, and 0.123 on lung under the depth ablation), and discrimination transfers while calibration does not---the highest-capacity readout (MLP-256) worsens ECE and temperature scaling closes only $\sim $1/3 of the gap}{figure.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Self-computed scRNA reliability across 24 atlases---the \emph  {constructive} flip-side of cluster K. \textbf  {(A)} selective abstention recovers accuracy (accuracy at 80\% coverage exceeds full-coverage accuracy for every baseline). \textbf  {(B)} temperature scaling lowers cross-batch ECE (orange$\to $blue) in most atlases but does not eliminate it---so abstention/recalibration are partial remedies for the coverage collapse, not a cure.}}{22}{figure.caption.39}\protected@file@percent }
\newlabel{fig:scrnarel}{{13}{22}{Self-computed scRNA reliability across 24 atlases---the \emph {constructive} flip-side of cluster K. \textbf {(A)} selective abstention recovers accuracy (accuracy at 80\% coverage exceeds full-coverage accuracy for every baseline). \textbf {(B)} temperature scaling lowers cross-batch ECE (orange$\to $blue) in most atlases but does not eliminate it---so abstention/recalibration are partial remedies for the coverage collapse, not a cure}{figure.caption.39}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Expanded (cluster K reframe): across 24 leakage-controlled scRNA atlases, cross-batch conformal coverage collapse is large and pervasive for \emph  {simple} baselines too (each blue point is one atlas; the labelled orange point per method is the across-atlas mean; positive in 20/24), showing it is a general exchangeability failure under batch shift, not an FM-specific defect.}}{23}{figure.caption.40}\protected@file@percent }
\newlabel{fig:multicov}{{14}{23}{Expanded (cluster K reframe): across 24 leakage-controlled scRNA atlases, cross-batch conformal coverage collapse is large and pervasive for \emph {simple} baselines too (each blue point is one atlas; the labelled orange point per method is the across-atlas mean; positive in 20/24), showing it is a general exchangeability failure under batch shift, not an FM-specific defect}{figure.caption.40}{}}
\citation{norman2019}
\citation{roohani2024}
\citation{ahlmann2025}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Cluster-K robustness checks. \textbf  {(A)} The readout-capacity$\to $out-of-batch-ECE effect is FM-general: the highest-capacity readout (MLP-256) is worst-calibrated for both scGPT (lung cross-batch) and a second family, Geneformer-V1-10M (pooled leave-one-batch-out over three atlases); MLP-64 is best for both, so it is an over-capacity effect, not a monotone one. \textbf  {(B)} Selective abstention on the lung scGPT cross-batch probe: the confidence-based reject option (green) sits far below random abstention on the risk--coverage curve (AURC 0.084 vs.\ 0.259), and is \emph  {fair to rare cell types}---they are retained more than common types (0.90 vs.\ 0.79), and the rare cells rejected are disproportionately errors (rejected-rare accuracy 0.54 vs.\ kept-rare 0.91).}}{24}{figure.caption.41}\protected@file@percent }
\newlabel{fig:kaddon}{{15}{24}{Cluster-K robustness checks. \textbf {(A)} The readout-capacity$\to $out-of-batch-ECE effect is FM-general: the highest-capacity readout (MLP-256) is worst-calibrated for both scGPT (lung cross-batch) and a second family, Geneformer-V1-10M (pooled leave-one-batch-out over three atlases); MLP-64 is best for both, so it is an over-capacity effect, not a monotone one. \textbf {(B)} Selective abstention on the lung scGPT cross-batch probe: the confidence-based reject option (green) sits far below random abstention on the risk--coverage curve (AURC 0.084 vs.\ 0.259), and is \emph {fair to rare cell types}---they are retained more than common types (0.90 vs.\ 0.79), and the rare cells rejected are disproportionately errors (rejected-rare accuracy 0.54 vs.\ kept-rare 0.91)}{figure.caption.41}{}}
\@writefile{toc}{\contentsline {subsection}{Self-computed scRNA suite: perturbation (cluster L)}{24}{subsection*.42}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Cluster L (perturbation). \textbf  {(A)} a label-fair, full-gene comparison (no oracle gene selection) on Norman-2019---the additive prior beats the deep GNN GEARS on all three combo strata ($\sim $3$\times $ lower MSE; 2.7--3.3$\times $), upgrading cluster L from exploratory to supported. \textbf  {(B)} GEARS' own predicted uncertainty gives a genuine but modest selective-prediction gain (abstaining on the top-30\% most-uncertain cells lowers retained MSE; partial Spearman 0.65 after effect-magnitude deconfounding). The panel-B $y$-axis is truncated (bar labels give absolute MSE); the reduction is ${\sim }5\%$, small in absolute terms.}}{25}{figure.caption.43}\protected@file@percent }
\newlabel{fig:perturb}{{16}{25}{Cluster L (perturbation). \textbf {(A)} a label-fair, full-gene comparison (no oracle gene selection) on Norman-2019---the additive prior beats the deep GNN GEARS on all three combo strata ($\sim $3$\times $ lower MSE; 2.7--3.3$\times $), upgrading cluster L from exploratory to supported. \textbf {(B)} GEARS' own predicted uncertainty gives a genuine but modest selective-prediction gain (abstaining on the top-30\% most-uncertain cells lowers retained MSE; partial Spearman 0.65 after effect-magnitude deconfounding). The panel-B $y$-axis is truncated (bar labels give absolute MSE); the reduction is ${\sim }5\%$, small in absolute terms}{figure.caption.43}{}}
