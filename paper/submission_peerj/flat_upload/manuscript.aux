\@writefile{lot}{\contentsline {table}{\numberline {A2}{\ignorespaces \emph  {Null-partition control for the label-vs-clustering $R^2_{\mathrm  {expr}}$ comparison} (cluster J; held-out batch of each matched/mismatch raw-count atlas). Columns are the fraction of held-out HVG-expression variance explained by: a size-matched \emph  {random} partition (permuted labels), the true cell-type \emph  {labels}, the \emph  {PCA} $K$-means clustering ($K{=}$\#labels), and the best-available \emph  {FM} $K$-means clustering. The labels beat the random null in 17/17 atlases (so they are not noise) yet fall below the variance-optimised PCA clustering in 17/17 (the cluster-J finding, here with a null floor). They fall below the \emph  {FM} clustering in only 9/17: on the cross-species/gene-ID atlases the human FM embedding is itself near-degenerate (FM-clustering $R^2_{\mathrm  {expr}}\!\approx \!0$, lower rows), the same tokenization failure as Fig.~\ref {fig:vocab}, read through the clustering. This control covers the 17 of the 20 atlases for which a size-matched random partition was computed; two of the three omitted atlases are among the 11/20 where labels fall below \emph  {both} clusterings, so the 9/17 here corresponds to that 11/20.}}{30}{table.caption.48}\protected@file@percent }
\newlabel{tab:nullctrl}{{A2}{30}{\emph {Null-partition control for the label-vs-clustering $R^2_{\mathrm {expr}}$ comparison} (cluster J; held-out batch of each matched/mismatch raw-count atlas). Columns are the fraction of held-out HVG-expression variance explained by: a size-matched \emph {random} partition (permuted labels), the true cell-type \emph {labels}, the \emph {PCA} $K$-means clustering ($K{=}$\#labels), and the best-available \emph {FM} $K$-means clustering. The labels beat the random null in 17/17 atlases (so they are not noise) yet fall below the variance-optimised PCA clustering in 17/17 (the cluster-J finding, here with a null floor). They fall below the \emph {FM} clustering in only 9/17: on the cross-species/gene-ID atlases the human FM embedding is itself near-degenerate (FM-clustering $R^2_{\mathrm {expr}}\!\approx \!0$, lower rows), the same tokenization failure as Fig.~\ref {fig:vocab}, read through the clustering. This control covers the 17 of the 20 atlases for which a size-matched random partition was computed; two of the three omitted atlases are among the 11/20 where labels fall below \emph {both} clusterings, so the 9/17 here corresponds to that 11/20}{table.caption.48}{}}
