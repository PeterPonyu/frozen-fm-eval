\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \emph  {External context: meta-analysis, LOBO reproduction, and integration trade-off} (clusters A--B, J). \textbf  {(A)} Per-study baseline win-rate vs.\ FM/DL (point size $\propto $ \#comparisons). \textbf  {(B)} Meta-analytic baseline win-rates by stratum (equal-weight per study; 95\% CI over studies). \textbf  {(C)} Self-computed (cluster J): on four leakage-controlled scRNA atlases, frozen zero-shot scFMs do not dominate classical baselines under leave-one-batch-out; PCA or scVI is best in every atlas. \textbf  {(D)} Integration trade-off: the one axis FMs ``win''---batch mixing (higher iLISI)---costs cell-type purity (higher cLISI); the purpose-built scVI dominates the mixing/purity trade-off (strictly best on both axes for B-cells, Pareto-front for the other two), so even the apparent integration advantage is no all-things-considered win (per-atlas iLISI gain $+0.6$/$+1.1$/$+2.4$ paired with cLISI cost $+0.1$/$+3.1$/$+1.5$; three atlases, an observation not a dose--response).}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:context}{{2}{6}{\emph {External context: meta-analysis, LOBO reproduction, and integration trade-off} (clusters A--B, J). \textbf {(A)} Per-study baseline win-rate vs.\ FM/DL (point size $\propto $ \#comparisons). \textbf {(B)} Meta-analytic baseline win-rates by stratum (equal-weight per study; 95\% CI over studies). \textbf {(C)} Self-computed (cluster J): on four leakage-controlled scRNA atlases, frozen zero-shot scFMs do not dominate classical baselines under leave-one-batch-out; PCA or scVI is best in every atlas. \textbf {(D)} Integration trade-off: the one axis FMs ``win''---batch mixing (higher iLISI)---costs cell-type purity (higher cLISI); the purpose-built scVI dominates the mixing/purity trade-off (strictly best on both axes for B-cells, Pareto-front for the other two), so even the apparent integration advantage is no all-things-considered win (per-atlas iLISI gain $+0.6$/$+1.1$/$+2.4$ paired with cLISI cost $+0.1$/$+3.1$/$+1.5$; three atlases, an observation not a dose--response)}{figure.2}{}}
