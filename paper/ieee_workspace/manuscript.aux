\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \emph  {Cluster-K reliability: cross-batch collapse (A--C) and its recovery/robustness (D--G).} \textbf  {(A)} frozen scGPT cross-batch conformal coverage is unstable (gap $>0$ in all four atlases; 0.012--0.075, and 0.123 on lung under the depth ablation). \textbf  {(B)} discrimination transfers but calibration does not---the highest-capacity readout (MLP-256) worsens out-of-batch ECE, temperature scaling closes only $\sim $1/3 of the gap. \textbf  {(C)} 24-atlas reframe: the collapse is large and pervasive for \emph  {simple} baselines too (blue $=$ per-atlas, orange $=$ across-atlas mean; positive in 20/24)---a general exchangeability failure, not an FM defect. \textbf  {(D)} selective abstention recovers accuracy (80\%-coverage accuracy exceeds full-coverage for every baseline). \textbf  {(E)} temperature scaling lowers but does not erase cross-batch ECE---partial remedies, not a cure. \textbf  {(F)} the readout-capacity$\to $ECE effect is FM-general (worst at MLP-256, best at MLP-64 for both scGPT and Geneformer-V1-10M): an over-capacity effect. \textbf  {(G)} the lung scGPT reject option beats random abstention (AURC 0.084 vs.\ 0.259) and is \emph  {fair to rare types}---retained more than common types (0.90 vs.\ 0.79), rejected rare cells disproportionately errors (0.54 vs.\ 0.91).}}{11}{figure.8}\protected@file@percent }
\newlabel{fig:reliabK}{{8}{11}{\emph {Cluster-K reliability: cross-batch collapse (A--C) and its recovery/robustness (D--G).} \textbf {(A)} frozen scGPT cross-batch conformal coverage is unstable (gap $>0$ in all four atlases; 0.012--0.075, and 0.123 on lung under the depth ablation). \textbf {(B)} discrimination transfers but calibration does not---the highest-capacity readout (MLP-256) worsens out-of-batch ECE, temperature scaling closes only $\sim $1/3 of the gap. \textbf {(C)} 24-atlas reframe: the collapse is large and pervasive for \emph {simple} baselines too (blue $=$ per-atlas, orange $=$ across-atlas mean; positive in 20/24)---a general exchangeability failure, not an FM defect. \textbf {(D)} selective abstention recovers accuracy (80\%-coverage accuracy exceeds full-coverage for every baseline). \textbf {(E)} temperature scaling lowers but does not erase cross-batch ECE---partial remedies, not a cure. \textbf {(F)} the readout-capacity$\to $ECE effect is FM-general (worst at MLP-256, best at MLP-64 for both scGPT and Geneformer-V1-10M): an over-capacity effect. \textbf {(G)} the lung scGPT reject option beats random abstention (AURC 0.084 vs.\ 0.259) and is \emph {fair to rare types}---retained more than common types (0.90 vs.\ 0.79), rejected rare cells disproportionately errors (0.54 vs.\ 0.91)}{figure.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-J}}Self-computed scRNA suite: perturbation (cluster L)}{11}{subsection.4.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Cluster L (perturbation). \textbf  {(A)} a label-fair, full-gene comparison (no oracle gene selection) on Norman-2019---the additive prior beats the deep GNN GEARS on all three combo strata ($\sim $3$\times $ lower MSE; 2.7--3.3$\times $), upgrading cluster L from exploratory to supported. \textbf  {(B)} GEARS' own predicted uncertainty gives a genuine but modest selective-prediction gain (abstaining on the top-30\% most-uncertain cells lowers retained MSE; partial Spearman 0.65 after effect-magnitude deconfounding). The panel-B $y$-axis is truncated (bar labels give absolute MSE); the reduction is ${\sim }5\%$, small in absolute terms.}}{12}{figure.9}\protected@file@percent }
\newlabel{fig:perturb}{{9}{12}{Cluster L (perturbation). \textbf {(A)} a label-fair, full-gene comparison (no oracle gene selection) on Norman-2019---the additive prior beats the deep GNN GEARS on all three combo strata ($\sim $3$\times $ lower MSE; 2.7--3.3$\times $), upgrading cluster L from exploratory to supported. \textbf {(B)} GEARS' own predicted uncertainty gives a genuine but modest selective-prediction gain (abstaining on the top-30\% most-uncertain cells lowers retained MSE; partial Spearman 0.65 after effect-magnitude deconfounding). The panel-B $y$-axis is truncated (bar labels give absolute MSE); the reduction is ${\sim }5\%$, small in absolute terms}{figure.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Per-family parity summary and per-atlas null-partition detail (cluster J). \textbf  {Top}: multi-FM check on the 11 vocabulary-matched human atlases under the fair $k$NN probe and reference-free $R^2_{\mathrm  {expr}}$. Five architecturally independent FM families span mean $k$NN $0.886$--$0.910$ \emph  {around} PCA's $0.894$---parity, none decisively beating or trailing PCA, while HVG alone is clearly worse; tripling parameters (Geneformer 104M$\to $316M) buys nothing. ``ties/beats'' counts atlases where the FM is within 0.02 of, or above, PCA. The 9 vocab-mismatch atlases are analysed separately (Fig.~\ref {fig:fair}). \textbf  {Bottom}: null-partition control (held-out batch of each raw-count atlas)---fraction of HVG-expression variance explained by a size-matched \emph  {random} partition, the true \emph  {labels}, the \emph  {PCA} $K$-means clustering, and the best \emph  {FM} clustering. Labels beat the random null in 17/17 (not noise) yet fall below the PCA clustering in 17/17 (the cluster-J finding, with a null floor), and below the FM clustering in only 9/17---on cross-species/gene-ID atlases the FM embedding is itself near-degenerate ($R^2_{\mathrm  {expr}}\!\approx \!0$), the Fig.~\ref {fig:fair}C,D tokenization failure read through clustering. Covers 17 of 20 atlases (those admitting a size-matched random partition).}}{12}{table.3}\protected@file@percent }
\newlabel{tab:parity_combined}{{III}{12}{Per-family parity summary and per-atlas null-partition detail (cluster J). \textbf {Top}: multi-FM check on the 11 vocabulary-matched human atlases under the fair $k$NN probe and reference-free $R^2_{\mathrm {expr}}$. Five architecturally independent FM families span mean $k$NN $0.886$--$0.910$ \emph {around} PCA's $0.894$---parity, none decisively beating or trailing PCA, while HVG alone is clearly worse; tripling parameters (Geneformer 104M$\to $316M) buys nothing. ``ties/beats'' counts atlases where the FM is within 0.02 of, or above, PCA. The 9 vocab-mismatch atlases are analysed separately (Fig.~\ref {fig:fair}). \textbf {Bottom}: null-partition control (held-out batch of each raw-count atlas)---fraction of HVG-expression variance explained by a size-matched \emph {random} partition, the true \emph {labels}, the \emph {PCA} $K$-means clustering, and the best \emph {FM} clustering. Labels beat the random null in 17/17 (not noise) yet fall below the PCA clustering in 17/17 (the cluster-J finding, with a null floor), and below the FM clustering in only 9/17---on cross-species/gene-ID atlases the FM embedding is itself near-degenerate ($R^2_{\mathrm {expr}}\!\approx \!0$), the Fig.~\ref {fig:fair}C,D tokenization failure read through clustering. Covers 17 of 20 atlases (those admitting a size-matched random partition)}{table.3}{}}
